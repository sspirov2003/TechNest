@model List<TechNestClean.Models.CartItem>
@{
    ViewData["Title"] = "Your Cart";
}

<h1>Your Cart</h1>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@((item.Price * item.Quantity).ToString("C"))</td>
                <td>
                    <form asp-action="Remove" asp-route-id="@item.ProductId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <h4>Total: <strong>@((ViewBag.Total).ToString("C"))</strong></h4>

    <form asp-action="Clear" method="post">
        <button type="submit" class="btn btn-outline-secondary">Clear Cart</button>
    </form>
}
