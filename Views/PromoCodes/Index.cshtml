@model IEnumerable<TechNestClean.Models.PromoCode>
@{
    ViewData["Title"] = "Promo Codes";
}

<h1>Promo Codes</h1>

<p class="mb-3">
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add Promo Code</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No promo codes have been created yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Code</th>
                <th>Discount</th>
                <th>Expiry</th>
                <th>Status</th>
                <th style="width:260px;">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            var isExpired = p.ExpiryDate.Date < DateTime.Today;
            var statusText = p.IsActive && !isExpired ? "Active" :
                             !p.IsActive ? "Inactive" : "Expired";

            var badgeClass = statusText switch
            {
                "Active" => "bg-success",
                "Inactive" => "bg-secondary",
                "Expired" => "bg-danger",
                _ => "bg-secondary"
            };

            <tr>
                <td>@p.Code</td>
                <td>@p.DiscountPercent %</td>
                <td>@p.ExpiryDate.ToShortDateString()</td>
                <td>
                    <span class="badge @badgeClass">@statusText</span>
                </td>
                <td>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit"
                           asp-route-id="@p.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <form asp-action="ToggleActive"
                              asp-route-id="@p.Id"
                              method="post">
                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                @(p.IsActive ? "Disable" : "Enable")
                            </button>
                        </form>

                        <form asp-action="Delete"
                              asp-route-id="@p.Id"
                              method="post"
                              onsubmit="return confirm('Delete promo code @p.Code ?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Delete
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
